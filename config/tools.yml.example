# config/tools.yml: per-tool toggles, call type and scheduling
#
# This file is auto-managed. On startup ProjectGabriel walks the live
# tool registry and adds any newly discovered tool here, defaulting it
# to enabled. Your existing values are never overwritten, so anything
# you change in here sticks across upgrades.
#
# Schema:
#   tools:                 # built-in tools shipped with the host
#     <tool_name>: bool
#     <tool_name>:
#       enabled: bool
#       type: auto | blocking | non_blocking
#       scheduling: when_idle | interrupt | silent
#   plugin_tools:          # tools added by modular plugins, grouped per plugin
#     <plugin_name>:
#       <tool_name>: bool
#
# The short `tool: true/false` form still works and means the same as
# `tool: {enabled: true}`. Use the long form when you want to set a type.
#
# ── type ── when the model has to wait for a tool result
#   auto          default. blocking on 2.5 and 3.1 models. On
#                 gemini-3.8-live built-in actions (emotes, movement,
#                 music) run in the background silently, quick lookups
#                 block, and slow lookups (web search, memory recall)
#                 run in the background and get mentioned when done.
#                 Plugin tools run in the background.
#   blocking      the model pauses and waits for the result. Predictable
#                 ordering, but the conversation stalls while the tool runs.
#   non_blocking  the tool runs in the background while the model keeps
#                 talking. Required by gemini-3.8-live-extended-thinking,
#                 which rejects blocking function calls outright.
#
# ── scheduling ── only used for non-blocking tools
#   when_idle     default. model finishes what it is saying, then brings
#                 the result up.
#   interrupt     model cuts itself off to report the result straight away.
#   silent        model never mentions it, just knows it for later.
#
# Settings the current model cannot honor are dropped automatically and
# the reason is printed in the console on startup, so a wrong pick here
# never breaks a session.
#
# Note: whether a plugin itself is loaded is controlled by the
# `enabled:` field inside that plugin's own plugins/<name>/plugin.yml,
# NOT by anything in this file. The toggles under plugin_tools.<plugin>
# only decide which of that plugin's tools get exposed to gemini once
# the plugin is loaded. This keeps the "is the plugin alive" decision
# next to the plugin code itself, while the per-tool toggles live here
# alongside everything else the operator can flip.
#
# Examples:
#   tools:
#     vrchatJump: false                 # turn a tool off
#     playMusic:
#       enabled: true
#       type: non_blocking              # start it, keep talking
#       scheduling: silent              # then never bring it up
#   plugin_tools:
#     example_plugin:
#       someTool: false                 # plugin still loads, tool hidden

tools: {}
plugin_tools: {}
